// Used for type-checking of TypeScript sources and config files (eslint.config.ts,
// vitest.config.ts, etc.), all run directly via Node type stripping or their own loaders.
{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    // Allow importing TypeScript sources with their `.ts` extension, as required by Node type stripping
    "allowImportingTsExtensions": true,
    // Avoid generating tsconfig.tsbuildinfo file, which isn't useful for our scenario
    "incremental": false,
    "noEmit": true,
  },
  "exclude": ["coverage"],
}
